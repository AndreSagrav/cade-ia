# Server
PORT=3001
NODE_ENV=development

# AI API Keys (add yours, never commit .env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Supabase (optional - for cloud sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Auth (login credentials - server-side only)
AUTH_USER=
AUTH_PASS=
